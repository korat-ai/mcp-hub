# Default open-source console: MCP relay surface only.
VITE_ENABLE_AGENT_PLATFORM=false

# Optional client-side error reporting. Leave blank for a no-telemetry build.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development

# Source-map upload is configured separately at build time with the complete
# SENTRY_AUTH_TOKEN / SENTRY_ORG / SENTRY_PROJECT / SENTRY_URL tuple.
