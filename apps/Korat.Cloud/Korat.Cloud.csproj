<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <!-- #178 cloud MAF agents on AG-UI (AG-UI hosting pkg is preview) -->
    <PackageReference Include="Microsoft.Agents.AI" />
    <PackageReference Include="Sentry.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Orleans.Clustering.AdoNet" />
    <PackageReference Include="NATS.Net" />
    <PackageReference Include="Npgsql" />
    <PackageReference Include="OpenIddict.AspNetCore" />
    <PackageReference Include="OpenIddict.EntityFrameworkCore" />
    <PackageReference Include="OpenIddict.Validation.ServerIntegration" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Orleans.Server" />
    <PackageReference Include="Microsoft.Orleans.Persistence.AdoNet" />
    <PackageReference Include="Microsoft.Orleans.Serialization.SystemTextJson" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <!-- 031 (mobile-push increment 2): FCM alert sender for Android. -->
    <PackageReference Include="FirebaseAdmin" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- 010-drop-redis-to-postgres: Orleans ADO.NET (PostgreSQL) clustering schema, applied at startup. -->
    <EmbeddedResource Include="Clustering\Sql\PostgreSQL-Main.sql" />
    <EmbeddedResource Include="Clustering\Sql\PostgreSQL-Clustering.sql" />
    <EmbeddedResource Include="Clustering\Sql\PostgreSQL-Clustering-3.7.0.sql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Korat.Domain\Korat.Domain.csproj" />
    <ProjectReference Include="..\..\src\Korat.Mcp\Korat.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Korat.Protocol\Korat.Protocol.csproj" />
    <ProjectReference Include="..\..\src\Korat.Grains\Korat.Grains.csproj" />
    <ProjectReference Include="..\..\src\Korat.GrainInterfaces\Korat.GrainInterfaces.csproj" />
    <ProjectReference Include="..\..\src\Korat.Persistence\Korat.Persistence.csproj" />
  </ItemGroup>

  <ItemGroup>
    <KoratAppInput Include="../Korat.App/src/**/*;../Korat.App/public/**/*;../Korat.App/package*.json;../Korat.App/index.html;../Korat.App/vite.config.ts;../Korat.App/tsconfig*.json"
                   Exclude="../Korat.App/src/routeTree.gen.ts" />
    <_KoratAppEvaluatedAsset Include="wwwroot/app/**" />
  </ItemGroup>

  <!-- A timestamp comparison alone cannot notice removed source/public files. -->
  <Target Name="TrackKoratAppInputs" Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true' And '$(NoBuild)' != 'true'">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <WriteLinesToFile File="$(IntermediateOutputPath)korat-app-inputs.txt" Lines="@(KoratAppInput)"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <FileWrites Include="$(IntermediateOutputPath)korat-app-inputs.txt" />
    </ItemGroup>
  </Target>

  <Target Name="BuildKoratApp" DependsOnTargets="TrackKoratAppInputs" Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true' And '$(NoBuild)' != 'true'"
          Inputs="@(KoratAppInput);$(IntermediateOutputPath)korat-app-inputs.txt;$(MSBuildProjectFullPath);$(KoratAppForceBuildTrigger)"
          Outputs="$(MSBuildThisFileDirectory)wwwroot/app/index.html">
    <Message Importance="high" Text="Building Korat.App SPA (npm + vite build)..." />
    <Exec Command="npm ci" WorkingDirectory="$(MSBuildThisFileDirectory)../Korat.App" Condition="'$(CI)' == 'true' Or '$(KoratAppNpmCi)' == 'true'" />
    <Exec Command="npm install" WorkingDirectory="$(MSBuildThisFileDirectory)../Korat.App" Condition="'$(CI)' != 'true' And '$(KoratAppNpmCi)' != 'true'" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)../Korat.App" />
  </Target>

  <!-- Build before the SDK fingerprints/compresses assets. Refresh evaluation-time
       globs even when npm is skipped: Vite replaces hashed filenames on each build. -->
  <Target Name="IncludeKoratAppAssets" BeforeTargets="ResolveProjectStaticWebAssets"
          DependsOnTargets="BuildKoratApp"
          Condition="'$(Configuration)' == 'Release' And '$(DesignTimeBuild)' != 'true' And '$(NoBuild)' != 'true'">
    <ItemGroup>
      <!-- Remove the original item identities, including files Vite has since deleted. -->
      <Content Remove="@(_KoratAppEvaluatedAsset)" />
      <Content Include="wwwroot/app/**" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <Target Name="CleanKoratApp" BeforeTargets="Clean">
    <RemoveDir Directories="$(MSBuildThisFileDirectory)wwwroot/app" />
  </Target>

</Project>
