<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.0.0-dev</Version>
    <InformationalVersion>0.0.0-dev+local</InformationalVersion>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <!-- Build-time Sentry DSN: pass -p:KoratSentryDsn=<dsn> at publish (release.yml),
         OR set the KORAT_SENTRY_DSN environment variable before building.
         When absent the baked constant is empty and the SDK stays a no-op.
         NEVER hardcode a real DSN here in source. -->
    <KoratSentryDsn Condition="'$(KoratSentryDsn)'==''">$(KORAT_SENTRY_DSN)</KoratSentryDsn>
    <KoratSentryDsn Condition="'$(KoratSentryDsn)'==''"></KoratSentryDsn>
    <!-- Generated file in obj/ — excluded from the default Compile glob so there
         are no duplicates and it is never tracked by git. -->
    <_SentryDsnGenFile>$(MSBuildProjectDirectory)/obj/SentryBakedDsn.g.cs</_SentryDsnGenFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Grpc.Net.Client" />
    <!-- Error tracking: Sentry base SDK (GlitchTip is Sentry-API-compatible).
         Sentry assembly roots are declared in ILLink.Descriptors.xml to prevent
         the trimmer from stripping reflection-used internals in a trimmed publish. -->
    <PackageReference Include="Sentry" />
  </ItemGroup>

  <!-- Tell the trimmer to keep all of Sentry (it uses reflection for event serialization). -->
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Korat.Domain\Korat.Domain.csproj" />
    <ProjectReference Include="..\..\src\Korat.Mcp\Korat.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Korat.Protocol\Korat.Protocol.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Korat.Cloud.ContractTests" />
    <InternalsVisibleTo Include="Korat.Cli.Tests" />
  </ItemGroup>

  <!--
    Bake the Sentry DSN as a compile-time string constant.
    The generated file goes into obj/ so it is never tracked by git and never
    conflicts with the default Compile glob.  DSN defaults to empty → no-op.
  -->
  <Target Name="GenerateSentryDsnConstant"
          BeforeTargets="BeforeBuild;CoreCompile">
    <PropertyGroup>
      <_EscapedDsn>$(KoratSentryDsn.Replace(`"`, ``))</_EscapedDsn>
    </PropertyGroup>
    <ItemGroup>
      <!-- Each item in _DsnLines becomes one line in the output file.
           MSBuild semicolons inside values must be escaped as %3B. -->
      <_DsnLines Include="// &lt;auto-generated/&gt; do not edit — regenerated by GenerateSentryDsnConstant." />
      <_DsnLines Include="namespace Korat.Cli.Telemetry%3B" />
      <_DsnLines Include="internal static partial class SentryInit" />
      <_DsnLines Include="{" />
      <_DsnLines Include="    internal const string BakedDsn = &quot;$(_EscapedDsn)&quot;%3B" />
      <_DsnLines Include="}" />
    </ItemGroup>
    <MakeDir Directories="$(MSBuildProjectDirectory)/obj" />
    <WriteLinesToFile
      File="$(_SentryDsnGenFile)"
      Lines="@(_DsnLines)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_SentryDsnGenFile)" />
    </ItemGroup>
  </Target>

</Project>
